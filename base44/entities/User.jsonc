{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "avatar_url": {
      "type": "string",
      "title": "Foto de perfil",
      "format": "uri"
    },
    "avatar_emoji": {
      "type": "string",
      "title": "Emoji de avatar",
      "default": "\ud83c\udf31"
    },
    "farm_name": {
      "type": "string",
      "title": "Nome da quinta"
    },
    "location": {
      "type": "string",
      "title": "Localiza\u00e7\u00e3o"
    },
    "farmer_type": {
      "type": "string",
      "title": "Tipo de agricultor",
      "enum": [
        "Amador",
        "Profissional",
        "Agricultura biol\u00f3gica",
        "Quinta familiar",
        "Permacultura",
        "Autossufici\u00eancia"
      ],
      "default": "Amador"
    },
    "experience_years": {
      "type": "number",
      "title": "Anos de experi\u00eancia",
      "default": 0
    },
    "favorite_crops": {
      "type": "string",
      "title": "Culturas favoritas"
    },
    "favorite_season": {
      "type": "string",
      "title": "Esta\u00e7\u00e3o favorita",
      "enum": [
        "Primavera",
        "Ver\u00e3o",
        "Outono",
        "Inverno"
      ],
      "default": "Primavera"
    },
    "bio": {
      "type": "string",
      "title": "Sobre mim"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}