{
  "name": "Mushroom",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nome",
      "description": "Nome comum do cogumelo"
    },
    "scientific_name": {
      "type": "string",
      "title": "Nome cient\u00edfico"
    },
    "common_names": {
      "type": "string",
      "title": "Nomes comuns",
      "description": "Nomes comuns e regionais em portugu\u00eas"
    },
    "emoji": {
      "type": "string",
      "title": "Emoji",
      "default": "\ud83c\udf44"
    },
    "color": {
      "type": "string",
      "title": "Cor",
      "default": "#a16207"
    },
    "image_url": {
      "type": "string",
      "title": "Imagem",
      "format": "uri"
    },
    "edibility": {
      "type": "string",
      "title": "Comestibilidade",
      "enum": [
        "Comest\u00edvel",
        "Comest\u00edvel com precau\u00e7\u00e3o",
        "T\u00f3xico",
        "Mortal"
      ],
      "default": "Comest\u00edvel"
    },
    "season_months": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      },
      "title": "Meses de \u00e9poca",
      "default": []
    },
    "habitat": {
      "type": "string",
      "title": "Habitat",
      "description": "Tipo de ambiente onde cresce"
    },
    "where_to_find": {
      "type": "string",
      "title": "Onde encontrar",
      "description": "Locais e condi\u00e7\u00f5es espec\u00edficas"
    },
    "how_to_pick": {
      "type": "string",
      "title": "Como apanhar"
    },
    "how_to_store": {
      "type": "string",
      "title": "Como armazenar"
    },
    "lookalikes": {
      "type": "string",
      "title": "Esp\u00e9cies parecidas",
      "description": "Risco de confus\u00e3o com outras esp\u00e9cies"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    }
  },
  "required": [
    "name",
    "emoji",
    "color",
    "edibility"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}