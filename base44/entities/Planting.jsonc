{
  "name": "Planting",
  "type": "object",
  "properties": {
    "plant_name": {
      "type": "string",
      "title": "Planta",
      "description": "Nome da planta"
    },
    "plant_emoji": {
      "type": "string",
      "title": "Emoji",
      "default": "\ud83c\udf31"
    },
    "plant_color": {
      "type": "string",
      "title": "Cor",
      "default": "#84cc16"
    },
    "planted_date": {
      "type": "string",
      "format": "date",
      "title": "Data de planta\u00e7\u00e3o"
    },
    "expected_harvest_date": {
      "type": "string",
      "format": "date",
      "title": "Colheita prevista"
    },
    "actual_harvest_date": {
      "type": "string",
      "format": "date",
      "title": "Data de colheita"
    },
    "location": {
      "type": "string",
      "title": "Localiza\u00e7\u00e3o",
      "description": "Onde na quinta (ex: canteiro 1, estufa)"
    },
    "quantity": {
      "type": "string",
      "title": "Quantidade"
    },
    "notes": {
      "type": "string",
      "title": "Notas"
    },
    "status": {
      "type": "string",
      "title": "Estado",
      "enum": [
        "Plantada",
        "Em crescimento",
        "Pronta a colher",
        "Colhida"
      ],
      "default": "Plantada"
    }
  },
  "required": [
    "plant_name",
    "planted_date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}